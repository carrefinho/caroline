(footprint "EC_Topre_1U_ViaSP" (version 20221018) (generator gen_ec_topre_1u)
  (layer "F.Cu")
  (descr "EC key, Topre-style housing + conical spring, 1U at 19.05 mm. Half-moon C electrodes OD 12.0 / void r 2.25 / gap 0.8, grounded 0.4 mm drain strip (solid pour connection at both tips), pour keepout D14 both layers. Housing: base 18.6x18.2 R3, top 14.6x14.0 C1.3, shared D3.2 standoff cutouts on the cell boundary. Pad 1 sense, 2 partner, 3 drain. centre vias + spurs on both pads.")
  (tags "EC electrostatic capacitive topre keyswitch")
